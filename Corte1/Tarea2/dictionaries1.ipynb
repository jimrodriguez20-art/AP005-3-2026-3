# Declara la lista 'songs' con títulos de canciones; establece las claves primarias para el registro de reproducciones.
songs = ["Like a Rolling Stone", "Satisfaction", "Imagine", "What's Going On", "Respect", "Good Vibrations"]
# Declara la lista 'playcounts' con el número de reproducciones entero; define los valores para el registro.
playcounts = [78, 29, 44, 21, 89, 5]
# Construye 'plays' emparejando 'songs' y 'playcounts' mediante comprensión y zip(); crea la base de datos de reproducciones.
plays = {key:value for key, value in zip(songs, playcounts)}
# Imprime en consola el diccionario 'plays'; muestra el mapa de canciones y conteo de reproducciones generado.
print(plays)
# Agrega la nueva canción "Purple Haze" con 1 reproducción usando .update(); extiende el diccionario con un nuevo tema.
plays.update({"Purple Haze": 1})
# Actualiza el conteo de la canción existente "Respect" a 94 reproducciones usando .update(); corrige el valor registrado.
plays.update({"Respect": 94})
# Imprime el diccionario 'plays' tras aplicar las dos actualizaciones; muestra las métricas finales ajustadas.
print("After: ", plays)
# Crea el diccionario anidado 'library' usando 'plays' como valor de "The Best Songs" y un diccionario vacío en "Sunday Feelings"; define una estructura compleja.
library = {"The Best Songs": plays, "Sunday Feelings": {}}
# Imprime la estructura completa de 'library'; muestra la composición de diccionarios anidados dentro de una biblioteca general.
print(library)

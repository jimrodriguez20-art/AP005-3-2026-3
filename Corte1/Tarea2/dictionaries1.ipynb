"source": [
"# Declara la lista 'names' con cadenas de texto conteniendo nombres de estudiantes; define los elementos que serán las claves.\n",
"names = ['Jenny', 'Alexus', 'Sam', 'Grace']\n",
"# Declara la lista 'heights' con valores enteros que representan las alturas; define los elementos que serán los valores.\n",
"heights = [61, 70, 67, 64]\n",
"\n",
"#Python allows you to create a dictionary using \n",
"# a dict comprehension, with this syntax:\n",
"\n",
"# Empareja de forma perezosa los elementos de 'names' y 'heights' creando un objeto iterador zip; combina secuencias en pares.\n",
"# zipStudents = zip(names, heights)\n",
"# Imprime la representación del objeto iterador 'zipStudents' en memoria; no muestra los datos procesados directamente.\n",
"# print("zipStudents: ", zipStudents)\n",
"\n",
"# Genera un diccionario usando comprensión al iterar las tuplas del 'zip'; mapea directamente los nombres con sus alturas.\n",
"# students = {key:value for key, value in zip(names, heights)}\n",
"# Muestra el diccionario 'students' resultante con las parejas creadas dinámicamente.\n",
"# #students is now {'Jenny': 61, 'Alexus': 70, 'Sam': 67, 'Grace': 64}\n",
"# print(students)\n",
"\n",
"# #zip() combines two lists into an iterator of tuples with the list elements paired together. This dict comprehension:\n",
"\n",
"# Declara la lista 'drinks' con los nombres de bebidas; conforma las claves para la estructura de contenido de cafeína.\n",
"# drinks = ["espresso", "chai", "decaf", "drip"]\n",
"# Declara la lista 'caffeine' con los mg de cafeína correspondientes a cada bebida; representa la secuencia de valores.\n",
"# caffeine = [64, 40, 0, 120]\n",
"\n",
"# Empareja las listas 'drinks' y 'caffeine' en un iterador 'zipped_drinks'; vincula los ítems con sus métricas.\n",
"# zipped_drinks = zip(drinks, caffeine)\n",
"# Imprime la referencia de memoria del objeto zip generado.\n",
"# print(zipped_drinks)\n",
"\n",
"# Construye el diccionario 'drinks_to_caffeine' iterando 'zipped_drinks'; asocia cada bebida con su nivel de cafeína.\n",
"# drinks_to_caffeine = {key:value for key, value in zipped_drinks}\n",
"# Imprime el diccionario completado con las bebidas y sus concentraciones de cafeína.\n",
"# print(drinks_to_caffeine)\n",
"\n",
"# Declara la lista 'songs' con títulos de canciones; establece las claves primarias para el registro de reproducciones.\n",
"songs = ["Like a Rolling Stone", "Satisfaction", "Imagine", "What's Going On", "Respect", "Good Vibrations"]\n",
"# Declara la lista 'playcounts' con el número de reproducciones entero; define los valores para el registro.\n",
"playcounts = [78, 29, 44, 21, 89, 5]\n",
"# Construye 'plays' emparejando 'songs' y 'playcounts' mediante comprensión y zip(); crea la base de datos de reproducciones.\n",
"plays = {key:value for key, value in zip(songs, playcounts)}\n",
"# Imprime en consola el diccionario 'plays'; muestra el mapa de canciones y conteo de reproducciones generado.\n",
"print(plays)\n",
"# Agrega la nueva canción "Purple Haze" con 1 reproducción usando .update(); extiende el diccionario con un nuevo tema.\n",
"plays.update({"Purple Haze": 1})\n",
"# Actualiza el conteo de la canción existente "Respect" a 94 reproducciones usando .update(); corrige el valor registrado.\n",
"plays.update({"Respect": 94})\n",
"# Imprime el diccionario 'plays' tras aplicar las dos actualizaciones; muestra las métricas finales ajustadas.\n",
"print("After: ", plays)\n",
"# Crea el diccionario anidado 'library' usando 'plays' como valor de "The Best Songs" y un diccionario vacío en "Sunday Feelings"; define una estructura compleja.\n",
"library = {"The Best Songs": plays, "Sunday Feelings": {}}\n",
"# Imprime la estructura completa de 'library'; muestra la composición de diccionarios anidados dentro de una biblioteca general.\n",
"print(library)"
]
